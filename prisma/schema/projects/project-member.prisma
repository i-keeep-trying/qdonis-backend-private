/// Direct access to a project for a user who is not its owner (was
/// `project_shares`). Revoking access deletes the row.
model ProjectMember {
  id             String      @id @default(uuid()) @db.Uuid
  projectId      String      @map("project_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  role           ProjectRole
  grantedById    String?     @map("granted_by_id") @db.Uuid
  /// Set when access came from a share link.
  shareLinkId    String?     @map("share_link_id") @db.Uuid
  expiresAt      DateTime?   @map("expires_at")
  lastAccessedAt DateTime?   @map("last_accessed_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User       @relation("ProjectMembership", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?      @relation("ProjectMemberGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  shareLink ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}
