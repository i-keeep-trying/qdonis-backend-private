# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Every variable is validated at boot by src/config/env.validation.ts — the
# app refuses to start if something is missing, malformed or unsafe for
# NODE_ENV=production.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Prefix applied to every route except the health checks, e.g. /api/v1/auth/login
API_PREFIX=api/v1
# Public URL of the web app (no trailing slash). Used in email links and as the
# landing page after Google sign-in. Its origin must be listed in CORS_ORIGINS.
# Must be https in production.
FRONTEND_URL=http://localhost:5173
# Number of reverse proxies in front of the app (load balancer = 1). 0 when the
# app is reached directly. Wrong values break rate limiting and secure cookies.
TRUST_PROXY_HOPS=0
# Max JSON body size. AI prompts can embed file contents, hence 5mb.
BODY_LIMIT=5mb
REQUEST_TIMEOUT_MS=30000

# --- database --------------------------------------------------------------
# The pgvector extension must be available in this database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qdonis?schema=public
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
# Dimension of the `embedding` column on the documents table. Must match the
# migration; changing it requires a new migration.
EMBEDDING_DIMENSIONS=1536

# --- auth: tokens ----------------------------------------------------------
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The two secrets must differ. Placeholders are rejected in production.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-value
# Access token lifetime (between 1m and 1h). Sent as `Authorization: Bearer`.
JWT_ACCESS_TTL=15m
JWT_ISSUER=qdonis-api
JWT_AUDIENCE=qdonis-web
# Lifetime of one refresh token. Refresh tokens are opaque random values in an
# httpOnly cookie, rotated on every refresh and stored only as SHA-256 hashes.
REFRESH_TOKEN_TTL=7d
# Signs the 10-minute Google OAuth state cookie (state + PKCE verifier + nonce).
OAUTH_STATE_SECRET=replace-me-with-a-different-long-random-value

# --- auth: policy ----------------------------------------------------------
# A login can be refreshed for at most this long, then the user signs in again.
AUTH_SESSION_ABSOLUTE_TTL=30d
# A just-rotated refresh token presented again within this many seconds is a
# benign race (two tabs); later it is treated as theft and the login revoked.
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
# Oldest logins are signed out beyond this many per user.
AUTH_MAX_SESSIONS_PER_USER=10
# Refuse password sign-in until the email address is verified.
AUTH_REQUIRE_VERIFIED_EMAIL=true
# Lock password sign-in for AUTH_LOCKOUT_DURATION_MS after this many failures.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_MS=900000
AUTH_EMAIL_VERIFICATION_TTL=24h
AUTH_PASSWORD_RESET_TTL=30m
# Minimum gap between two verification / reset emails to the same account.
AUTH_EMAIL_COOLDOWN_SECONDS=60
# Purge of expired sessions and used tokens. 0 disables.
AUTH_CLEANUP_INTERVAL_MS=3600000

# --- auth: Google sign-in ----------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Add GOOGLE_REDIRECT_URI exactly as an "Authorized redirect URI".
# Required in production while GOOGLE_OAUTH_ENABLED=true; in development the
# Google endpoints answer "not configured" until these are set.
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback


# --- Stripe ------------------------------------------------------------------
# Required in production (live keys only). In development, billing endpoints
# answer 503 BILLING_NOT_CONFIGURED until both are set.
# Webhook endpoint to register in Stripe (Developers → Webhooks):
#   https://<api-host>/api/v1/billing/stripe/webhook
# Events: checkout.session.completed, invoice.paid, invoice.payment_failed,
#         customer.subscription.updated, customer.subscription.deleted
# Local testing: stripe listen --forward-to localhost:3000/api/v1/billing/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI (AWS Bedrock) ----------------------------------------------------------
# Replaces the Supabase bedrock-proxy function. Usage is charged to the
# caller's token balance on the server. AI endpoints answer 503 while unset.
# Auth mode: when AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY are both set, they
# sign requests (SigV4, IAM user needs bedrock:InvokeModel*); otherwise
# BEDROCK_API_KEY is sent as a bearer token. Set both AWS keys or neither.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region precedence: BEDROCK_REGION (optional, Bedrock only), then AWS_REGION,
# then us-east-1.
AWS_REGION=us-east-1
BEDROCK_API_KEY=
BEDROCK_REGION=
# Comma-separated allowlist; the first entry is the default model.
BEDROCK_ALLOWED_MODELS=us.anthropic.claude-sonnet-4-5-20250929-v1:0,anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional: a cheaper model for project-name generation (must be in the allowlist).
BEDROCK_NAMING_MODEL=
BEDROCK_MAX_OUTPUT_TOKENS=64000
BEDROCK_TIMEOUT_MS=600000

# --- file storage (S3 + CloudFront) ---------------------------------------------
# Replaces Supabase Storage. Required in production; without S3_BUCKET the
# file routes answer 503 STORAGE_NOT_CONFIGURED.
# Bucket: private (Block Public Access on), default encryption on. Credentials:
# the AWS key pair above when set, otherwise the instance/task role. The role
# needs s3:PutObject, s3:GetObject, s3:DeleteObject, s3:ListBucket on the bucket.
# Browser uploads go straight to S3 with presigned PUTs, so the bucket CORS must
# allow PUT from CORS_ORIGINS with headers Content-Type, x-amz-server-side-encryption.
S3_BUCKET=
# Falls back to AWS_REGION.
S3_REGION=
# Optional prefix for every key, e.g. prod/ (segments end with /).
S3_KEY_PREFIX=
# Development only (MinIO / LocalStack), e.g. http://localhost:9000
S3_ENDPOINT=
# Downloads are CloudFront signed URLs. The distribution uses the bucket as an
# origin with Origin Access Control and a trusted key group ("Restrict viewer
# access"). Set all three or none (none = S3 presigned GETs, development only).
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
# PEM private key of the key group's public key: raw PEM with \n escapes, or base64.
CLOUDFRONT_PRIVATE_KEY=
# Lifetime of signed upload/download URLs (60-86400).
STORAGE_URL_TTL_SECONDS=900
# How often queued S3 deletions and abandoned uploads are cleaned; 0 = off.
STORAGE_SWEEP_INTERVAL_MS=300000

# --- component suppliers (Mouser Search API) --------------------------------------
# Server-side only (was VITE_MOUSER_API_KEY in the browser bundle: rotate it).
# Unset = sourcing routes answer 503 SUPPLIER_NOT_CONFIGURED.
MOUSER_API_KEY=
# Mouser's per-key quotas, enforced across all instances (429 when exceeded).
MOUSER_CALLS_PER_MINUTE=30
MOUSER_CALLS_PER_DAY=1000
# How long search results are reused; 0 disables the cache.
MOUSER_CACHE_HOURS=24

# --- simulation (ngspice) ------------------------------------------------------
# ngspice executable: a path (e.g. D:\Spice64\bin\ngspice.exe) or a name on PATH.
NGSPICE_PATH=ngspice
# Limit of one analysis run, in seconds.
NGSPICE_TIMEOUT_SECONDS=300
# Simulations run at once on this instance; extra runs wait for a slot.
SIMULATION_CONCURRENCY=2

# --- mail (Gmail SMTP) -------------------------------------------------------
# smtp = real delivery (required in production). log = print emails, links
# included, to the console (development only).
MAIL_TRANSPORT=log
# Shown as the sender. With Gmail this must be the account itself or a
# verified "Send mail as" alias.
MAIL_FROM=Qdonis <your-account@gmail.com>
SMTP_HOST=smtp.gmail.com
# 465 with SMTP_SECURE=true (implicit TLS), or 587 with SMTP_SECURE=false (STARTTLS)
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Gmail App Password (Google Account → Security → 2-Step Verification → App
# passwords). Not the normal account password.
SMTP_PASSWORD=

# --- cookies ---------------------------------------------------------------
# Must be true in production (requires HTTPS).
COOKIE_SECURE=false
# lax | strict | none — use `none` (requires COOKIE_SECURE=true) when the
# frontend is on a different site than the API.
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# --- CORS ------------------------------------------------------------------
# Comma-separated allowlist of frontend origins. Credentials are enabled, so
# `*` is rejected. Also used as the CSRF origin check on /auth/refresh|logout.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- rate limiting ---------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Tighter per-IP bucket for login/register/password/email/Google endpoints
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10

# --- logging ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# Pretty-print logs (development only; disable in production)
LOG_PRETTY=true

# --- API docs (never served in production) -----------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
