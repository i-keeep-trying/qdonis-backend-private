/// A shareable project link. Opening it (signed in) grants `role` as a
/// `ProjectMember`. The token is stored as-is so owners can copy the link
/// again; anyone able to read this table can already read the projects.
model ShareLink {
  id             String        @id @default(uuid()) @db.Uuid
  projectId      String        @map("project_id") @db.Uuid
  token          String        @unique
  type           ShareLinkType
  /// VIEWER or EDITOR only (enforced in the service).
  role           ProjectRole
  /// Lower-cased email domains, for DOMAIN_RESTRICTED links.
  allowedDomains String[]      @default([]) @map("allowed_domains")
  /// Argon2id, for PASSWORD_PROTECTED links.
  passwordHash   String?       @map("password_hash")
  maxUses        Int?          @map("max_uses")
  uses           Int           @default(0)
  expiresAt      DateTime?     @map("expires_at")
  isActive       Boolean       @default(true) @map("is_active")
  createdById    String?       @map("created_by_id") @db.Uuid
  lastUsedAt     DateTime?     @map("last_used_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("ShareLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ProjectMember[]

  @@index([projectId, isActive])
  @@map("share_links")
}
