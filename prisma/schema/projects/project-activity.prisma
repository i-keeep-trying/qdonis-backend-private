/// Append-only audit feed of what happened on a project.
model ProjectActivity {
  id        String              @id @default(uuid()) @db.Uuid
  projectId String              @map("project_id") @db.Uuid
  userId    String?             @map("user_id") @db.Uuid
  type      ProjectActivityType
  details   Json                @default("{}")
  /// Lifecycle stage the action touched, when there is one.
  stage     String?
  createdAt DateTime            @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation("ProjectActivityActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@map("project_activity")
}
