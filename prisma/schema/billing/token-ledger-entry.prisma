/// Append-only audit of every token movement (positive = grant, negative =
/// usage). `idempotencyKey` makes retried grants and usage reports
/// exactly-once: a second write with the same key is rejected by the index.
model TokenLedgerEntry {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  amount         Int
  reason         String
  idempotencyKey String   @unique @map("idempotency_key")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("token_ledger")
}
