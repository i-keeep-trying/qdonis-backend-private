    { "role": "user", "content": [{ "type": "text", "text": "Yes, isolated please." }] },
    {
      "role": "assistant",
      "content": [
        { "type": "text", "text": "Designing now." },
        { "type": "tool_use", "id": "tu_c", "name": "run_design", "input": {} }
      ]
