/// Email invitation to a project for someone without an account yet. Only a
/// SHA-256 hash of the token is stored; the token itself is in the email.
model ProjectInvitation {
  id           String      @id @default(uuid()) @db.Uuid
  projectId    String      @map("project_id") @db.Uuid
  /// Trimmed and lower-cased.
  email        String
  role         ProjectRole
  tokenHash    String      @unique @map("token_hash")
  message      String?
  invitedById  String?     @map("invited_by_id") @db.Uuid
  expiresAt    DateTime    @map("expires_at")
  acceptedAt   DateTime?   @map("accepted_at")
  acceptedById String?     @map("accepted_by_id") @db.Uuid
  revokedAt    DateTime?   @map("revoked_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy  User?   @relation("ProjectInvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?   @relation("ProjectInvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([projectId, email])
  @@index([email])
  @@map("project_invitations")
}
