/// Design-assistant chat history, private to each user within a project
/// (was `chat_messages`).
model ProjectChatMessage {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @map("project_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  sender    ChatSender
  content   String
  metadata  Json       @default("{}")
  createdAt DateTime   @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectChatAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, userId, createdAt])
  @@map("project_chat_messages")
}
